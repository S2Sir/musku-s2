rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Enforce strict multi-tenant isolation per authenticated Firebase UID
    match /users/{userId}/{document=**} {
      // User can ONLY read, write, update, or delete their OWN document tree
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all unauthenticated or cross-tenant access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
